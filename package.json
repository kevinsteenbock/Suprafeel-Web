{
  "name": "suprafeel-soft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist -m \"deploy: Suprafeel Soft front\"",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=esm --outfile=./.smoke.mjs --jsx=automatic --loader:.jpg=dataurl --define:import.meta.env.BASE_URL='\"/\"' --alias:@=./src --external:react --external:react-dom --external:react-router --log-level=error && node ./.smoke.mjs",
    "xano:seed": "esbuild scripts/dump-seed.mjs --bundle --platform=node --format=esm --outfile=./.dump-seed.mjs --loader:.jpg=dataurl --define:import.meta.env.BASE_URL='\"/Suprafeel-Web/\"' --packages=external --log-level=error && node ./.dump-seed.mjs && rm -f ./.dump-seed.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
